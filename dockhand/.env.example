# ============================================
# Service: dockhand
# Copy to .env and fill in YOUR_* / GENERATE_ME_* values.
# ============================================

# Global Variables
CONF=YOUR_CONF_DIR
TZ=America/New_York
IP=YOUR_SERVER_IP
HOMEPAGE_GROUP=Data

# Dockhand Configuration
# Host path for Dockhand data — must match host-side of ${CONF}/dockhand:/app/data mount
HOST_DATA_DIR=YOUR_CONF_DIR/dockhand  # service-specific
# Generate with: openssl rand -base64 32
# Keep stable — changing it loses stored credentials.
# NOT marked service-specific on purpose: global.env is the source of truth for
# this key, and global-env-sync.py preserves any var whose line carries one of
# the override comments (service-specific, override, ...). Marked, this key can
# never be rotated from global.env and the sync silently keeps the stale local
# copy (data-lab t_35b04ad9).
ENCRYPTION_KEY=GENERATE_ME_ENCRYPTION_KEY
