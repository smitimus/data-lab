#!/usr/bin/env python3
"""Stub `docker` for exercising install.sh's Superset dashboard step off-host.

Answers the call shapes the step makes, from a synthetic bundle so the fixtures
are the same shape as the real
`superset/dashboards/verisim_grocery_dashboards.zip` (dashboards/, charts/,
datasets/<db>/, databases/, one `uuid:` per object — the real bundle's counts
are not asserted here):

  docker inspect -f '{{.State.Running}}' postgres
  docker exec postgres psql -U postgres -d <db> -tAc "<sql>"

STUB_SCENARIO:
  deferred    the mart schema exists but is empty (no transform has run)
  nomart      the mart schema does not exist at all (cold EDW)
  missingmart marts exist and 42+ tables there, but one bundled dataset's table
              is absent — the count alone must not be enough
  clean       marts complete, every bundled object present, nothing null
  broken      marts complete, every object present, but the bundle's own 18
              charts landed with query_context null (what dev shows today)
  partial     3 bundled charts never landed (a silent partial import)
  nopg        the postgres container is not running
  dangling    clean, but a bundled dashboard's layout names a chart Superset
              has no slice row for (a tile that cannot render)

The bundled dashboards' LINK state (dashboard_slices vs the chart ids
position_json names) is modelled too, because install.sh reconciles it after the
import: dashboard 20 starts at 16 links for 8 layout slots (a second chart
generation left behind), dashboard 22 at 3 links for 4 slots (a layout slot that
lost its link — the seed-replaces-the-links direction), dashboard 21 is already
consistent. STUB_LINK_STATE names the file the stub reads/writes that state in:
absent = the pre-import (broken) instance, "reconciled" after the write query
runs, which is what makes a second `--dashboards-only` a no-op in the test.

The CHART ROWS a previous seed generation left behind are modelled the same way,
because install.sh prunes them after the reconcile (prune_superseded_charts):
the SELECT that hunts for a chart no layout names, no dashboard links and a
placed same-name/same-dataset chart shadows answers two rows (ids 3 and 4, the
fixture's own chart names) until that run's DELETE calls land, then none.
STUB_PRUNE_STATE names the file that flips, and STUB_SCENARIO=prune422 makes the
chart DELETE answer 422 (the API refusing a chart it still considers referenced)
so the test can require the run to go red on it.
"""
import os
import re
import sys
import zipfile

SCENARIO = os.environ.get("STUB_SCENARIO", "clean")
ZIP = os.environ["STUB_ZIP"]
LINK_STATE = os.environ.get("STUB_LINK_STATE", "")
PRUNE_STATE = os.environ.get("STUB_PRUNE_STATE", "")

z = zipfile.ZipFile(ZIP)


def field(name, key):
    body = z.read(name).decode("utf-8", "replace")
    m = re.search(r"^" + key + r":\s*(\S+)", body, re.M)
    return m.group(1) if m else None


names = [n for n in z.namelist() if n.endswith(".yaml")]


def objects(kind):
    return [n for n in names if "/" + kind + "/" in n]


CHART_UUIDS = [(field(n, "uuid") or "").lower() for n in objects("charts")]
DASH_UUIDS = [(field(n, "uuid") or "").lower() for n in objects("dashboards")]
DS_UUIDS = [(field(n, "uuid") or "").lower() for n in objects("datasets")]
MART_TABLES = sorted({field(n, "table_name") for n in objects("datasets") if field(n, "table_name")})
CHART_NAMES = [n.rsplit("/", 1)[1][:-5].replace("_", " ") for n in objects("charts")]

# 42 is the gate's bar (dbt materialises 42 mart models); the bundled datasets
# are part of that 42 on a real host, so fill up to 42 + the bundled ones.
if SCENARIO in ("clean", "broken", "partial", "import422", "missingmart", "nologin", "dangling", "prune422"):
    ALL_MARTS = MART_TABLES + ["mart_extra_%02d" % i for i in range(1, 43)]
else:
    ALL_MARTS = []
if SCENARIO == "missingmart":
    ALL_MARTS = [t for t in ALL_MARTS if t != MART_TABLES[0]]

# charts Superset knows about
if SCENARIO == "partial":
    LANDED_CHARTS = CHART_UUIDS[: len(CHART_UUIDS) - 3]
else:
    LANDED_CHARTS = CHART_UUIDS

META = {
    "dashboards": len(DASH_UUIDS) + 11,
    "slices": 34,
    "null_ds": 0,
    "null_qc": len(CHART_UUIDS) if SCENARIO == "broken" else 0,
}

# The bundled dashboards as Superset holds them: (id, title, layout slots, links).
# 20 = a second chart generation is still linked, 22 = a layout slot lost its
# link, 21 = already consistent.
LINKED_DASHES = [(20, "Verisim Overview 1", 8, 16),
                 (21, "Verisim Overview 2", 6, 6),
                 (22, "Verisim Overview 3", 4, 3)]


def link_state():
    """(conciled?) — the state file the write query flips."""
    if not LINK_STATE:
        return False
    try:
        return open(LINK_STATE).read().strip() == "reconciled"
    except OSError:
        return False


def link_rows():
    out = []
    for did, title, slots, links in LINKED_DASHES:
        if link_state():
            links = slots
        out.append("%d|%s|%d|%d" % (did, title, slots, links))
    return "\n".join(out)


def reconcile():
    """(unlinked, linked) — what the delete/insert would report, and flip the state."""
    unlinked = linked = 0
    for _, _, slots, links in LINKED_DASHES:
        if link_state():
            continue
        if links > slots:
            unlinked += links - slots
        elif slots > links:
            linked += slots - links
    if LINK_STATE:
        with open(LINK_STATE, "w") as fh:
            fh.write("reconciled\n")
    return "%d|%d" % (unlinked, linked)


# The chart rows a previous seed generation left behind: same name and same
# dataset as a chart the imported layout places, named by no layout, linked to no
# dashboard. install.sh deletes them (prune_superseded_charts) — so the SELECT
# answers them once, and nothing the second time. Dashboard 3's copy of a chart
# also linked there is the other half of the rule (a chart another dashboard uses
# is never a candidate), so the fixture keeps one row (id 5) that the stub never
# reports as superseded.
SUPERSEDED = [(3, CHART_NAMES[0] if CHART_NAMES else "Chart 01"),
              (4, CHART_NAMES[1] if len(CHART_NAMES) > 1 else "Chart 02")]


def superseded_rows():
    if PRUNE_STATE:
        try:
            if open(PRUNE_STATE).read().strip() == "pruned":
                return ""
        except OSError:
            pass
        with open(PRUNE_STATE, "w") as fh:
            fh.write("pruned\n")
    return "\n".join("%d|%s" % row for row in SUPERSEDED)


def answer(sql):
    s = re.sub(r"\s+", " ", sql).strip()
    if "information_schema.tables where table_schema='mart'" in s:
        return "\n".join(ALL_MARTS)
    # most specific first: the count queries are prefixes of nothing but share a prefix
    if "datasource_id is null" in s:
        return str(META["null_ds"])
    if "query_context is null" in s and "string_agg" in s:
        return ", ".join(CHART_NAMES[:8])
    if "query_context is null" in s:
        return str(META["null_qc"])
    if "select count(*) from dashboards" in s:
        return str(META["dashboards"])
    if "select count(*) from slices" in s:
        return str(META["slices"])
    if "select uuid from dashboards" in s:
        return "\n".join(DASH_UUIDS + ["0000aaaa-0000-0000-0000-00000000000%d" % i for i in range(11)])
    if "select uuid from slices" in s:
        return "\n".join(LANDED_CHARTS + ["1111bbbb-0000-0000-0000-0000000000%02d" % i for i in range(34)])
    if "select uuid from tables" in s:
        return "\n".join(DS_UUIDS)
    # install.sh's post-import link reconcile, in the order it asks:
    if "s.id || '|' || s.slice_name" in s:
        return superseded_rows()
    if "delete from dashboard_slices" in s:
        return reconcile()
    if "select count(*) from named n where not exists" in s:
        return "1" if SCENARIO == "dangling" else "0"
    if "d.dashboard_title" in s and "jsonb_each" in s:
        return link_rows()
    if "dashboard_slices" in s:
        n = len(DASH_UUIDS) + 11
        return "  ".join("%d=%d dashboard_%02d" % (i, 6 + i, i) for i in range(1, n + 1))
    return ""


def main(argv):
    if argv[:1] == ["inspect"]:
        print("false" if SCENARIO == "nopg" else "true")
        return 0
    if argv[:1] == ["exec"]:
        # exec postgres psql -U postgres -d <db> -tAc <sql>
        sql = argv[-1]
        out = answer(sql)
        if out:
            print(out)
        return 0
    return 0


sys.exit(main(sys.argv[1:]))
