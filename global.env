# ============================================
# Global Docker Environment Variables
# ============================================
# These variables are shared by all services.
# Use global-env-sync.py to push changes to all service .env files:
#   cd stacks && python global-env-sync.py
#
# The Secrets section at the bottom ships *recognisable defaults* so a clone
# starts out of the box. They are not secrets — read that section before
# exposing the instance anywhere, and rotate them with:
#   bash generate-secrets.sh

# Base Paths
CONF=/opt/data-lab/_conf               # ${CONF} - Configuration directory
STACKS=/opt/data-lab          # ${STACKS} - Stack install directory

# System Configuration
TZ=America/New_York              # ${TZ} - Timezone

# Network Configuration
# Must stay a placeholder: install.sh and infra/scripts/app-layer.sh substitute the
# detected LAN IP per host. A committed real IP silently re-points a rebuilt instance
# at whichever host last committed its value (observed 2026-09-20: every service .env
# on the new dev guest came up with IP=192.168.1.7, the host being replaced).
IP=YOUR_SERVER_IP             # ${IP} - Server IP address

# Homepage Configuration
HOMEPAGE_GROUP=Data              # ${HOMEPAGE_GROUP} - Homepage dashboard group name

# Extra Host values the homepage dashboard accepts besides ${IP} and localhost,
# comma-separated (the slot's short name, e.g. dev / test). Must stay a placeholder for
# the same reason IP does: a committed real value follows the repo onto another host and
# then 400s every browser there. install.sh fill_env / infra/scripts/app-layer.sh
# substitute it per host.
HOMEPAGE_ALLOWED_HOSTNAMES=YOUR_HOSTNAME

# PostgreSQL Shared Credentials (EDW — used by postgres, superset, dbt-docs, meltano)
POSTGRES_USER=postgres           # ${POSTGRES_USER} - Shared EDW superuser
POSTGRES_PASSWORD=postgres       # ${POSTGRES_PASSWORD} - Shared EDW password

# MinIO S3-compatible storage (data-lab#35 executive report export target)
# Internal endpoint http://minio:9000 (Docker DNS on postgres_network).
# Console (web UI) exposed on host at http://${IP}:9001.
# DEV DEFAULTS — change before any non-local deployment.
S3_ENDPOINT=http://minio:9000   # ${S3_ENDPOINT} - MinIO service URL (internal)
S3_ACCESS_KEY=admin                # ${S3_ACCESS_KEY} - MinIO root user (default)
S3_SECRET_KEY=adminadmin            # ${S3_SECRET_KEY} - MinIO root password (>=8 chars; MinIO enforces min 8, so literal 'admin' would fail to start)
S3_BUCKET=reports                # ${S3_BUCKET} - bucket for exported reports
S3_REGION=us-east-1             # ${S3_REGION} - bucket region (cosmetic for MinIO)
# ============================================
# Secrets
# ============================================
# Every value below is a shipped default: a clone must be able to start out of
# the box, so none of them is empty. They are *recognisable* defaults on
# purpose. A shipped default that looks like a rotated secret is worse than no
# default at all — it starts the stack AND the rotation path cannot tell it
# from a real key, so it never replaces it. That is exactly how the five
# published defaults of 2026-09-20 (b18088e) stayed live on every host seeded
# from this file (data-lab t_35b04ad9).
#
# ROTATE ALL FIVE before the instance is exposed beyond a trusted network:
#
#   bash generate-secrets.sh
#
# replaces the three sentinels with one per-host shared secret and runs
# global-env-sync.py to propagate it to every service .env.
#
# The two key-shaped defaults cannot be a sentinel: Airflow's Fernet key and
# Dockhand's encryption key must each be a well-formed key or their consumer
# refuses to start. They are real, throwaway keys instead — `base64 -d` on
# either one prints "data-lab-shipped-default-key-00N". generate-secrets.sh
# leaves them alone (it cannot tell a dummy from a real key) and warns instead,
# because rotating each one is a deliberate, planned step:
#   - AIRFLOW_FERNET_KEY decrypts connection passwords already stored in the
#     Airflow metadata DB. Rotate it with a connections export/import, never a
#     find/replace, or the stored passwords become unreadable.
#   - ENCRYPTION_KEY is Dockhand's at-rest key: rotating it makes Dockhand's
#     stored credentials unreadable, and dockhand/.env is the file that
#     actually carries it.
#
# SUPERSET_SECRET_KEY is the third at-rest key and the odd one out: it *is* one
# of the three sentinels above, so generate-secrets.sh does replace it — on a
# fresh clone nothing is encrypted under it yet, and leaving it sentinel-shaped
# would start Superset on a published key. On an instance that has already
# provisioned its connections, replacing it is the deliberate-step case, and
# the generator warns accordingly:
#   - Superset encrypts every connection password it stores with SECRET_KEY
#     (dbs.password / encrypted_extra / server_cert in the `superset` metadata
#     DB). The stored ciphertext stays under the old key, so every path that
#     decrypts it fails — GET /api/v1/database/ 500s with "Invalid decryption
#     key" and the one-shot superset-setup crash-loops — while container health
#     stays green and login still works. Re-encrypt as part of the rotation,
#     and keep the old value until that has succeeded:
#       docker exec superset superset re-encrypt-secrets \
#         --previous_secret_key "<the old SUPERSET_SECRET_KEY>"
#     If the old key is already gone, the password has to be re-entered
#     instead. `superset set-database-uri` cannot do it on its own: it loads
#     the Database row first, which decrypts, which is the thing that fails.
#     Clear the unreadable columns, then re-enter the URI:
#       docker exec postgres psql -U postgres -d superset -c \
#         "update dbs set password = null, encrypted_extra = null where id = 1;"
#       docker exec superset sh -c 'superset set-database-uri -d Grocery \
#         -u "postgresql+psycopg2://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/grocery"'
#     (Clearing encrypted_extra discards the stored connection extras — empty
#     for a stock install — and the password comes back from the environment.)
AIRFLOW_SECRET_KEY=GENERATE_ME_SECRET
AIRFLOW_JWT_SECRET=GENERATE_ME_SECRET
SUPERSET_SECRET_KEY=GENERATE_ME_SECRET
# Shipped default: urlsafe base64 of "data-lab-shipped-default-key-001".
AIRFLOW_FERNET_KEY=ZGF0YS1sYWItc2hpcHBlZC1kZWZhdWx0LWtleS0wMDE=
# Shipped default: base64 of "data-lab-shipped-default-key-002".
ENCRYPTION_KEY=ZGF0YS1sYWItc2hpcHBlZC1kZWZhdWx0LWtleS0wMDI=
