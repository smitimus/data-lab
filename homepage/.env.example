# ============================================
# Service: Homepage
# Copy to .env and fill in YOUR_* values.
# ============================================

# Global Variables
CONF=YOUR_CONF_DIR
TZ=America/New_York
IP=YOUR_SERVER_IP
HOMEPAGE_GROUP=Data

# Extra Host values the dashboard accepts, comma-separated, in addition to ${IP} and
# localhost — e.g. the slot's short name (dev / test). Matched verbatim against the
# whole Host header; do NOT put a space after a comma. Substituted per host.
HOMEPAGE_ALLOWED_HOSTNAMES=YOUR_HOSTNAME
